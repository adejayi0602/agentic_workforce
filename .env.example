# Local development only. Copy to .env. Never put real secrets in this file.

# API
WORKFORCE_ENV=local
WORKFORCE_LOG_LEVEL=INFO
# The API connects as workforce_api (subject to row-level security).
WORKFORCE_DATABASE_URL=postgresql+asyncpg://workforce_api:workforce_api@localhost:5432/workforce
# Alembic connects as the schema owner.
WORKFORCE_MIGRATION_DATABASE_URL=postgresql+asyncpg://workforce:workforce@localhost:5432/workforce
# Database tests create a throwaway database through a superuser connection.
WORKFORCE_TEST_ADMIN_DATABASE_URL=postgresql+asyncpg://workforce:workforce@localhost:5432/postgres
WORKFORCE_CORS_ORIGINS=["http://localhost:3000"]

# Temporal
WORKFORCE_TEMPORAL_ADDRESS=localhost:7233
WORKFORCE_TEMPORAL_NAMESPACE=default
WORKFORCE_TEMPORAL_TASK_QUEUE=workforce-main

# Object storage (MinIO locally, S3 in AWS)
WORKFORCE_S3_ENDPOINT_URL=http://localhost:9000
WORKFORCE_S3_BUCKET_UPLOADS=workforce-uploads
WORKFORCE_S3_BUCKET_ARTEFACTS=workforce-artefacts
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=eu-west-1

# Redis
WORKFORCE_REDIS_URL=redis://localhost:6379/0

# LLM gateway (ADR-0005). Supported provider: "anthropic" (Claude).
# "fake" needs no key and is the default for local runs and tests.
WORKFORCE_LLM_PROVIDER=fake
# WORKFORCE_LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=  # set only in your local .env, never commit

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
